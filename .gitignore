# Deploy-time build metadata — written by scripts/deploy/deploy-railway.mjs
# before `railway up` so the Dockerfile can bake the deployed commit's SHA
# into the running container. The deploy script cleans these up on exit;
# we ignore them here so an interrupted deploy can't commit stale metadata.
/BUILD_SHA
/BUILD_TIMESTAMP

# Release Lock — generated CI artifacts are ignored; only the
# committed template at reports/FARROWAY_RELEASE_LOCK_V1.template.json
# is tracked so pipelines can see the expected shape.
reports/*.json
!reports/*.template.json
