{
  "name": "farroway",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "cd server && npm test",
    "test:security": "cd server && npm run test:security",
    "test:auth": "cd server && npm run test:auth",
    "test:isolated": "cd server && npm run test:isolated",
    "dev": "vite",
    "prebuild": "node scripts/build-icons.mjs",
    "build": "vite build && cd server && npx prisma generate && npx tsc -p intelligence/tsconfig.json",
    "clean": "node scripts/clean-dist.mjs",
    "build:clean": "npm run clean && npm run build",
    "check:assets": "node scripts/check-realism-assets.mjs",
    "check:production-assets": "node scripts/check-production-assets.mjs",
    "check:url-construction": "node scripts/check-url-construction.mjs",
    "check:urls": "node scripts/check-url-construction.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:intelligence": "node scripts/check-intelligence.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "check:deployment-sources": "node scripts/ci/check-deployment-sources.mjs",
    "validate:production": "node scripts/validate-production-readiness.mjs",
    "build:safe": "npm run check:assets && npm run check:production-assets && npm run check:url-construction && npm run check:icons && npm run check:intelligence && npm run check:translations && npm run check:deployment-sources && npm run build",
    "deploy:railway": "node scripts/deploy/deploy-railway.mjs --auto-pull",
    "deploy:dry-run": "node scripts/deploy/deploy-railway.mjs --dry-run --auto-pull",
    "verify:deployment": "node scripts/deploy/verify-deployment.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:intelligence": "cd server && npx tsc -p intelligence/tsconfig.json",
    "start": "node scripts/prisma-deploy-with-baseline.mjs && cd server && node scripts/init-admin.mjs && node src/server.js",
    "postinstall": "[ -d server ] && cd server && npm install || true",
    "db:push": "cd server && npx prisma db push",
    "db:seed": "cd server && node prisma/seed.js",
    "seed:demo": "cd server && node prisma/seed-demo.js",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:hooks": "node scripts/list-hook-violations.mjs",
    "build:android": "vite build && npx cap sync android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "build:ios": "vite build && npx cap sync ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "guard:prisma": "node scripts/ci/check-prisma-safety.mjs",
    "guard:migration": "node scripts/ci/check-migration-safety.mjs",
    "guard:crops": "node scripts/ci/check-crop-type-drift.mjs",
    "guard:i18n": "node scripts/ci/check-i18n-coverage.mjs",
    "guard:i18n-parity": "node scripts/ci/check-i18n-parity.mjs",
    "guard:duplicate-crops": "node scripts/ci/check-duplicate-crop-sources.mjs",
    "guard:crop-render": "node scripts/ci/check-raw-crop-render.mjs",
    "guard:env": "node scripts/ci/check-env-assertions.mjs --mode=prod",
    "guard:mobile": "node scripts/ci/check-mobile-readiness.mjs",
    "guard:telemetry": "node scripts/ci/check-launch-telemetry.mjs",
    "guard:ios-quirks": "node scripts/ci/check-ios-quirks.mjs",
    "guard:server-boot": "node scripts/ci/check-server-boot.mjs",
    "guards": "npm run guard:prisma && npm run guard:migration && npm run guard:crops && npm run guard:i18n && npm run guard:i18n-parity && npm run guard:duplicate-crops && npm run guard:crop-render && npm run guard:mobile && npm run guard:telemetry && npm run guard:ios-quirks && npm run guard:server-boot && npm run guard:env",
    "check:i18n": "node scripts/check-i18n.js",
    "check:crop-labels": "node scripts/check-raw-crop-render.js",
    "check:deps": "node scripts/ci/check-circular-deps.mjs",
    "launch-gate": "node scripts/launch-gate.mjs",
    "launch-gate:fast": "node scripts/launch-gate.mjs --fast --no-build",
    "launch-gate:final": "npm run launch-gate:fast && npm run guard:i18n && npm run guard:crop-render && npm run guard:mobile && npm run guard:telemetry && npm run guard:ios-quirks",
    "security:scan-secrets": "node scripts/ci/scan-secrets.mjs",
    "security:routes": "node scripts/audit-routes.mjs",
    "security:test:unit": "node scripts/ci/run-security-tests.mjs",
    "security:test": "node scripts/ci/run-api-security-harness.mjs",
    "security:curl": "bash security-tests/curl-tests.sh",
    "security:all": "npm run security:test && npm run security:curl",
    "security:audit": "npm run security:scan-secrets && npm run security:test:unit",
    "launch-gate:security": "npm run security:audit"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.3.0",
    "@sentry/react": "^10.52.0",
    "axios": "^1.7.9",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.0.6",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.1.1",
    "react-smooth": "^2.0.5",
    "recharts": "^2.15.0",
    "redis": "^5.12.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
