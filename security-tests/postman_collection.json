        },
        {
          "name": "23 — OPTIONS preflight",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "https://example.invalid" },
              { "key": "Access-Control-Request-Method", "value": "GET" }
            ],
            "url": { "raw": "{{API_BASE_URL}}/api/farms", "host": ["{{API_BASE_URL}}"], "path": ["api", "farms"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
