    {
      "name": "Scan Upload",
      "item": [
        {
          "name": "13 — Upload non-image (text base64) → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{USER_A_FARMER_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"imageBase64\":\"bm90IGFuIGltYWdl\"}" },
            "url": { "raw": "{{API_BASE_URL}}/api/scan/analyze", "host": ["{{API_BASE_URL}}"], "path": ["api", "scan", "analyze"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 400 / 415 / 429', function () { pm.expect(pm.response.code).to.be.oneOf([400, 415, 429]); });"
            ] } }
          ]
        },
        {
          "name": "16 — Empty scan body → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{USER_A_FARMER_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{API_BASE_URL}}/api/scan/analyze", "host": ["{{API_BASE_URL}}"], "path": ["api", "scan", "analyze"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 400 / 422 / 429', function () { pm.expect(pm.response.code).to.be.oneOf([400, 422, 429]); });"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "Rate Limit",
      "item": [
        {
          "name": "12 — Scan rate-limit fires (run via Runner with N≥35 iterations)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{USER_A_FARMER_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"plantName\":\"tomato\"}" },
            "url": { "raw": "{{API_BASE_URL}}/api/scan/analyze", "host": ["{{API_BASE_URL}}"], "path": ["api", "scan", "analyze"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "// Track 429 across runner iterations via pm.environment.",
              "if (pm.response.code === 429) {",
              "  pm.environment.set('SAW_429', '1');",
              "}",
              "var seen = pm.environment.get('SAW_429') === '1';",
              "pm.test('Eventually 429 across runner iterations', function () {",
              "  pm.expect(seen || pm.response.code === 429).to.be.true;",
              "});"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "Error Safety",
      "item": [
        {
          "name": "15 — Invalid farm id returns clean error",
